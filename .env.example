DATABASE_URL="file:./dev.db"

# Used to sign session cookies. Generate a strong random value for production,
# e.g. `openssl rand -hex 32`.
SESSION_SECRET="replace-with-a-long-random-string"

# Seed script login credentials (change after first login in production)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Length of the free trial new organizations get at signup.
TRIAL_DAYS=14

# Optional: used to build absolute URLs for Stripe redirects. If unset, the
# app derives it from the incoming request's Host header.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe billing (optional in development — leave blank to disable billing) ---
# Secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# Signing secret from the webhook endpoint you create in the Stripe dashboard
# (or from `stripe listen --forward-to localhost:3000/api/stripe/webhook`)
STRIPE_WEBHOOK_SECRET=""
# Price IDs for each plan (Stripe dashboard -> Product catalog -> a recurring price)
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
