// Prisma schema for the Car Rental Fleet Manager
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum VehicleStatus {
  AVAILABLE
  BOOKED
  RESERVED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum BookingStatus {
  HOLD
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  /// Billed to an accredited corporate account rather than collected
  /// through the app — not a payment failure, just a different rail.
  INVOICED
}

enum ChargeStatus {
  PENDING
  PAID
  CANCELLED
}

enum BookingSource {
  STAFF
  ONLINE
}

enum RentalOption {
  SELF_DRIVE
  WITH_DRIVER
}

enum BookingLocationMethod {
  GARAGE
  DELIVERED
}

enum ExpenseCategory {
  FUEL
  MAINTENANCE
  INSURANCE
  REGISTRATION
  CLEANING
  PARKING_TOLLS
  OTHER
}

enum UserRole {
  OWNER
  STAFF
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  createdAt            DateTime @default(now())

  // Public storefront content
  tagline              String?
  aboutText            String?
  logoUrl              String?
  heroImageUrl         String?
  contactPhone         String?
  contactEmail         String?
  address              String?
  facebookUrl          String?
  instagramUrl         String?
  tiktokUrl            String?
  requirementsText     String?
  /// Full contract body shown in the payment-confirmation email and the
  /// e-sign page. Falls back to DEFAULT_TERMS_AND_CONDITIONS when unset.
  termsAndConditionsText String?

  // Stripe billing (organization's subscription to this SaaS)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)

  // PayMongo (organization's own account — collects renter payments directly)
  paymongoSecretKey    String?
  paymongoPublicKey    String?
  paymongoWebhookSecret String?
  paymongoLiveMode     Boolean  @default(false)
  reservationFeeAmount Float    @default(500)
  holdFeeAmount        Float    @default(350)

  // Booking detail add-ons — configured once, applied automatically so
  // online payment stays instant/deterministic (no manual quoting).
  offersDriverService  Boolean  @default(false)
  driverFeePerDay      Float    @default(0)
  deliveryFeeAmount    Float    @default(0)
  dropoffFeeAmount     Float    @default(0)
  carwashFeeAmount     Float    @default(0)
  excessHourlyRate     Float    @default(0)

  // GoHighLevel CRM (organization's own existing sub-account/location)
  ghlLocationId        String?
  ghlApiToken          String?

  // Automated SMS nurturing (reminders + holiday/birthday greetings), sent
  // via the GHL connection above. See src/lib/sms-nurture.ts.
  smsRemindersEnabled         Boolean @default(false)
  smsBirthdayGreetingsEnabled Boolean @default(false)
  smsHolidayGreetingsEnabled  Boolean @default(false)
  /// Customers with no booking activity for this many months are
  /// automatically removed from nurture SMS (smsOptOut set to true).
  smsInactivityMonths         Int     @default(24)

  users            User[]
  vehicles         Vehicle[]
  customers        Customer[]
  bookings         Booking[]
  bookingInquiries BookingInquiry[]
  bookingCharges   BookingCharge[]
  corporateClients CorporateClient[]
  expenses         Expense[]
  maintenanceLogs  MaintenanceLog[]
  fuelLogs         FuelLog[]
  faqs             Faq[]
  testimonials     Testimonial[]
  smsLogs          SmsLog[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           UserRole @default(STAFF)
  /// Ignored for OWNER (always full access). For STAFF, a map of permission
  /// key -> boolean, e.g. {"fleet": true, "billing": false}. See src/lib/permissions.ts.
  permissions    Json?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Vehicle {
  id            String   @id @default(cuid())
  organizationId String
  plateNumber   String
  make          String
  model         String
  year          Int
  color         String?
  category      String?
  seats         Int?
  transmission  String?
  description   String?
  photoUrl      String?
  featured      Boolean  @default(false)
  dailyRate     Float
  status        VehicleStatus @default(AVAILABLE)
  odometer      Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  bookingInquiries BookingInquiry[]
  expenses      Expense[]
  maintenanceLogs MaintenanceLog[]
  fuelLogs      FuelLog[]

  @@unique([organizationId, plateNumber])
  @@index([organizationId, status])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String
  address        String?
  driverLicense  String?
  notes          String?
  /// Captured from the customer's driver's license at the counter — powers
  /// automated birthday SMS greetings. Not collected on public self-signup.
  birthday       DateTime?
  /// True once removed from automated SMS nurturing — manually by staff, or
  /// automatically after organization.smsInactivityMonths of no bookings.
  smsOptOut       Boolean  @default(false)
  smsOptOutReason String?
  /// Set only when this customer self-registered on the public storefront.
  passwordHash   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  bookingInquiries BookingInquiry[]
  smsLogs        SmsLog[]

  @@unique([organizationId, email])
  @@index([organizationId, name])
}

model Booking {
  id               String   @id @default(cuid())
  organizationId   String
  vehicleId        String
  customerId       String
  startDate        DateTime
  endDate          DateTime
  status           BookingStatus @default(RESERVED)
  source           BookingSource @default(STAFF)
  dailyRate        Float
  totalAmount      Float
  securityDeposit  Float    @default(0)
  depositReturned  Boolean  @default(false)
  amountPaid       Float    @default(0)
  paymentStatus    PaymentStatus @default(UNPAID)
  paymongoCheckoutId String?
  /// Set only while status = HOLD. The unit is blocked on the calendar until
  /// this time; if the hold isn't converted before it passes, it's released.
  holdExpiresAt    DateTime?
  /// Set only for bookings made against an accredited corporate account —
  /// no online payment is collected; the company is billed separately.
  corporateClientId String?
  pickupLocation   String?
  dropoffLocation  String?
  rentalOption     RentalOption @default(SELF_DRIVE)
  pickupMethod     BookingLocationMethod @default(GARAGE)
  dropoffMethod    BookingLocationMethod @default(GARAGE)
  startTime        String?
  endTime          String?
  excessHours      Int      @default(0)
  carwashRequested Boolean  @default(false)
  destinationDetails String?
  purposeOfTravel  String?
  howFoundUs       String?
  driverFee        Float    @default(0)
  deliveryFee      Float    @default(0)
  dropoffFee       Float    @default(0)
  carwashFee       Float    @default(0)
  excessTimeFee    Float    @default(0)
  notes            String?

  /// Random token for the public e-sign link mailed to the client; generated
  /// on demand the first time a confirmation email is sent.
  signatureToken   String?  @unique
  signedAt         DateTime?
  signedName       String?
  /// "ONLINE" (clicked the e-sign link) or "PHYSICAL" (staff recorded a
  /// signed printout at pickup).
  signedMethod     String?
  signedIp         String?

  confirmationEmailSentAt DateTime?
  confirmationEmailError  String?

  /// Set once the automated day-before pickup/return SMS reminder is sent,
  /// so the daily cron never double-sends. See src/lib/sms-nurture.ts.
  pickupReminderSentAt  DateTime?
  returnReminderSentAt  DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  corporateClient  CorporateClient? @relation(fields: [corporateClientId], references: [id])
  charges          BookingCharge[]

  @@index([organizationId])
  @@index([vehicleId])
  @@index([customerId])
  @@index([startDate, endDate])
  @@index([paymongoCheckoutId])
  @@index([corporateClientId])
}

/// A balance-due or incidental charge (late fee, damage, fuel, excess
/// mileage) collected via its own PayMongo checkout so staff never have to
/// take cash — each charge is its own payment event on top of the booking.
model BookingCharge {
  id                 String       @id @default(cuid())
  organizationId     String
  bookingId          String
  description        String
  amount             Float
  status             ChargeStatus @default(PENDING)
  paymongoCheckoutId String?
  /// "paymongo" when collected online, "manual" when a staffer recorded an
  /// offline payment as a fallback (e.g. PayMongo was down).
  paidVia            String?
  recordedByUserId   String?
  createdAt          DateTime     @default(now())
  paidAt             DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([bookingId])
  @@index([paymongoCheckoutId])
}

/// An accredited corporate client whose bookings skip online payment and
/// get billed separately. Gated by a shared access code so a public visitor
/// can't just pick a company name off the dropdown and get a free booking.
model CorporateClient {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  accessCode     String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

/// A "request a callback" lead from the storefront — no payment, no calendar
/// hold. Staff follow up and create a real Booking manually if it converts.
model BookingInquiry {
  id             String        @id @default(cuid())
  organizationId String
  vehicleId      String
  customerId     String
  startDate      DateTime
  endDate        DateTime
  message        String?
  status         InquiryStatus @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([vehicleId])
}

model Expense {
  id             String   @id @default(cuid())
  organizationId String
  vehicleId      String
  category       ExpenseCategory
  amount         Float
  date           DateTime
  description    String?
  vendor         String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vehicleId])
  @@index([date])
  @@index([category])
}

model MaintenanceLog {
  id              String   @id @default(cuid())
  organizationId  String
  vehicleId       String
  type            String
  date            DateTime
  cost            Float    @default(0)
  odometer        Int?
  vendor          String?
  nextDueDate     DateTime?
  nextDueOdometer Int?
  notes           String?
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vehicleId])
  @@index([date])
  @@index([nextDueDate])
}

model FuelLog {
  id             String   @id @default(cuid())
  organizationId String
  vehicleId      String
  date           DateTime
  liters         Float
  cost           Float
  odometer       Int?
  fullTank       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vehicleId])
  @@index([date])
}

model Faq {
  id             String   @id @default(cuid())
  organizationId String
  question       String
  answer         String
  order          Int      @default(0)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Testimonial {
  id             String   @id @default(cuid())
  organizationId String
  authorName     String
  quote          String
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Audit trail + idempotency guard for every automated nurture SMS (and a
/// place to see send history). The unique constraint is what stops the
/// daily cron from double-sending the same birthday/holiday greeting to the
/// same customer if it's ever triggered twice in one day.
model SmsLog {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String?
  /// "PICKUP_REMINDER" | "RETURN_REMINDER" | "BIRTHDAY" | "HOLIDAY"
  kind           String
  /// e.g. "pickup:<bookingId>", "birthday:2026", "holiday:2026-12-25"
  dedupeKey      String
  message        String
  status         String
  error          String?
  sentAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, customerId, dedupeKey])
  @@index([organizationId, kind])
}
