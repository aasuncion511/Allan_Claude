// Prisma schema for the Car Rental Fleet Manager
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum VehicleStatus {
  AVAILABLE
  BOOKED
  RESERVED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum BookingStatus {
  HOLD
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BookingSource {
  STAFF
  ONLINE
}

enum ExpenseCategory {
  FUEL
  MAINTENANCE
  INSURANCE
  REGISTRATION
  CLEANING
  PARKING_TOLLS
  OTHER
}

enum UserRole {
  OWNER
  STAFF
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  createdAt            DateTime @default(now())

  // Public storefront content
  tagline              String?
  aboutText            String?
  logoUrl              String?
  heroImageUrl         String?
  contactPhone         String?
  contactEmail         String?
  address              String?
  facebookUrl          String?
  instagramUrl         String?
  tiktokUrl            String?
  requirementsText     String?

  // Stripe billing (organization's subscription to this SaaS)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)

  // PayMongo (organization's own account — collects renter payments directly)
  paymongoSecretKey    String?
  paymongoPublicKey    String?
  paymongoWebhookSecret String?
  paymongoLiveMode     Boolean  @default(false)
  reservationFeeAmount Float    @default(500)
  holdFeeAmount        Float    @default(350)

  // GoHighLevel CRM (organization's own existing sub-account/location)
  ghlLocationId        String?
  ghlApiToken          String?

  users            User[]
  vehicles         Vehicle[]
  customers        Customer[]
  bookings         Booking[]
  bookingInquiries BookingInquiry[]
  expenses         Expense[]
  maintenanceLogs  MaintenanceLog[]
  fuelLogs         FuelLog[]
  faqs             Faq[]
  testimonials     Testimonial[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           UserRole @default(STAFF)
  /// Ignored for OWNER (always full access). For STAFF, a map of permission
  /// key -> boolean, e.g. {"fleet": true, "billing": false}. See src/lib/permissions.ts.
  permissions    Json?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Vehicle {
  id            String   @id @default(cuid())
  organizationId String
  plateNumber   String
  make          String
  model         String
  year          Int
  color         String?
  category      String?
  seats         Int?
  transmission  String?
  description   String?
  photoUrl      String?
  featured      Boolean  @default(false)
  dailyRate     Float
  status        VehicleStatus @default(AVAILABLE)
  odometer      Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  bookingInquiries BookingInquiry[]
  expenses      Expense[]
  maintenanceLogs MaintenanceLog[]
  fuelLogs      FuelLog[]

  @@unique([organizationId, plateNumber])
  @@index([organizationId, status])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String
  address        String?
  driverLicense  String?
  notes          String?
  /// Set only when this customer self-registered on the public storefront.
  passwordHash   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  bookingInquiries BookingInquiry[]

  @@unique([organizationId, email])
  @@index([organizationId, name])
}

model Booking {
  id               String   @id @default(cuid())
  organizationId   String
  vehicleId        String
  customerId       String
  startDate        DateTime
  endDate          DateTime
  status           BookingStatus @default(RESERVED)
  source           BookingSource @default(STAFF)
  dailyRate        Float
  totalAmount      Float
  securityDeposit  Float    @default(0)
  depositReturned  Boolean  @default(false)
  amountPaid       Float    @default(0)
  paymentStatus    PaymentStatus @default(UNPAID)
  paymongoCheckoutId String?
  /// Set only while status = HOLD. The unit is blocked on the calendar until
  /// this time; if the hold isn't converted before it passes, it's released.
  holdExpiresAt    DateTime?
  pickupLocation   String?
  dropoffLocation  String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vehicleId])
  @@index([customerId])
  @@index([startDate, endDate])
  @@index([paymongoCheckoutId])
}

/// A "request a callback" lead from the storefront — no payment, no calendar
/// hold. Staff follow up and create a real Booking manually if it converts.
model BookingInquiry {
  id             String        @id @default(cuid())
  organizationId String
  vehicleId      String
  customerId     String
  startDate      DateTime
  endDate        DateTime
  message        String?
  status         InquiryStatus @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([vehicleId])
}

model Expense {
  id             String   @id @default(cuid())
  organizationId String
  vehicleId      String
  category       ExpenseCategory
  amount         Float
  date           DateTime
  description    String?
  vendor         String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vehicleId])
  @@index([date])
  @@index([category])
}

model MaintenanceLog {
  id              String   @id @default(cuid())
  organizationId  String
  vehicleId       String
  type            String
  date            DateTime
  cost            Float    @default(0)
  odometer        Int?
  vendor          String?
  nextDueDate     DateTime?
  nextDueOdometer Int?
  notes           String?
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vehicleId])
  @@index([date])
  @@index([nextDueDate])
}

model FuelLog {
  id             String   @id @default(cuid())
  organizationId String
  vehicleId      String
  date           DateTime
  liters         Float
  cost           Float
  odometer       Int?
  fullTank       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vehicleId])
  @@index([date])
}

model Faq {
  id             String   @id @default(cuid())
  organizationId String
  question       String
  answer         String
  order          Int      @default(0)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Testimonial {
  id             String   @id @default(cuid())
  organizationId String
  authorName     String
  quote          String
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
