// Prisma schema for the Car Rental Fleet Manager
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum VehicleStatus {
  AVAILABLE
  BOOKED
  RESERVED
  MAINTENANCE
  OUT_OF_SERVICE
}

/// Drives the category-specific non-refundable reservation fee (see
/// Organization.sedan/suv/pickupReservationFee). Null = reservation pricing
/// not configured yet for this unit — online reservation is blocked with a
/// clear message rather than guessing a price.
enum ReservationCategory {
  SEDAN
  SUV
  PICKUP
}

enum BookingStatus {
  HOLD
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  /// Billed to an accredited corporate account rather than collected
  /// through the app — not a payment failure, just a different rail.
  INVOICED
}

enum ChargeStatus {
  PENDING
  PAID
  CANCELLED
}

/// Security deposits never count toward revenue (see src/lib/metrics.ts) —
/// they're held, not earned. HELD is summed for the "Security Deposit on
/// Hand" dashboard figure.
enum SecurityDepositStatus {
  NOT_COLLECTED
  HELD
  REFUNDED
}

enum BookingSource {
  STAFF
  ONLINE
}

enum RentalOption {
  SELF_DRIVE
  WITH_DRIVER
}

enum BookingLocationMethod {
  GARAGE
  DELIVERED
}

enum ExpenseCategory {
  FUEL
  MAINTENANCE
  INSURANCE
  REGISTRATION
  CLEANING
  PARKING_TOLLS
  OTHER
}

enum UserRole {
  OWNER
  STAFF
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum ThemeName {
  CLASSIC
  MODERN
  ADVENTURE
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  createdAt            DateTime @default(now())

  // Public storefront content
  /// Selectable storefront design — swaps accent color, hero gradient, and
  /// section backgrounds via the [data-theme] CSS variables in globals.css.
  /// Never affects the admin app, only the public /r/[slug] storefront.
  theme                ThemeName @default(CLASSIC)
  tagline              String?
  aboutText            String?
  logoUrl              String?
  heroImageUrl         String?
  contactPhone         String?
  contactEmail         String?
  address              String?
  facebookUrl          String?
  instagramUrl         String?
  tiktokUrl            String?
  requirementsText     String?
  /// Full contract body shown in the payment-confirmation email and the
  /// e-sign page. Falls back to DEFAULT_TERMS_AND_CONDITIONS when unset.
  termsAndConditionsText String?

  // Stripe billing (organization's subscription to this SaaS)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)

  // PayMongo (organization's own account — collects renter payments directly)
  paymongoSecretKey    String?
  paymongoPublicKey    String?
  paymongoWebhookSecret String?
  paymongoLiveMode     Boolean  @default(false)

  // Free server-controlled hold, then a category-specific non-refundable
  // reservation payment (credited toward the rental total). Replaces the
  // old flat reservationFeeAmount/holdFeeAmount model — see
  // src/lib/reservation-pricing.ts. Centrally configured, not a front-end
  // constant, per the v2 handoff's "non-resetting timer" requirement.
  holdWindowSeconds     Int   @default(1500)
  sedanReservationFee   Float @default(800)
  suvReservationFee     Float @default(1000)
  pickupReservationFee  Float @default(1000)
  /// Flat refundable security deposit default, same across every unit —
  /// pre-fills new bookings; editable per booking. Never counts as revenue.
  securityDepositAmount Float @default(2000)

  // Booking detail add-ons — configured once, applied automatically so
  // online payment stays instant/deterministic (no manual quoting).
  offersDriverService  Boolean  @default(false)
  driverFeePerDay      Float    @default(0)
  deliveryFeeAmount    Float    @default(0)
  dropoffFeeAmount     Float    @default(0)
  carwashFeeAmount     Float    @default(0)
  excessHourlyRate     Float    @default(0)

  // GoHighLevel CRM (organization's own existing sub-account/location)
  ghlLocationId        String?
  ghlApiToken          String?

  // Automated SMS nurturing (reminders + holiday/birthday greetings), sent
  // via the GHL connection above. See src/lib/sms-nurture.ts.
  smsRemindersEnabled         Boolean @default(false)
  smsBirthdayGreetingsEnabled Boolean @default(false)
  smsHolidayGreetingsEnabled  Boolean @default(false)
  /// Customers with no booking activity for this many months are
  /// automatically removed from nurture SMS (smsOptOut set to true).
  smsInactivityMonths         Int     @default(24)

  users            User[]
  vehicles         Vehicle[]
  customers        Customer[]
  bookings         Booking[]
  bookingInquiries BookingInquiry[]
  bookingCharges   BookingCharge[]
  corporateClients CorporateClient[]
  expenses         Expense[]
  maintenanceLogs  MaintenanceLog[]
  fuelLogs         FuelLog[]
  customerDocuments CustomerDocument[]
  bookingInspections BookingInspection[]
  faqs             Faq[]
  testimonials     Testimonial[]
  smsLogs          SmsLog[]
  refunds          Refund[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           UserRole @default(STAFF)
  /// Ignored for OWNER (always full access). For STAFF, a map of permission
  /// key -> boolean, e.g. {"fleet": true, "billing": false}. See src/lib/permissions.ts.
  permissions    Json?
  /// Cross-tenant: lets this user see/manage every organization on the
  /// platform via /platform-admin, regardless of their role within their own
  /// org. Never grantable through the app UI — only via the PLATFORM_ADMIN_EMAIL
  /// boot-time grant script (scripts/grant-platform-admin.mjs), so a client's
  /// own OWNER role can never accidentally become a platform admin.
  isPlatformAdmin Boolean @default(false)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Vehicle {
  id            String   @id @default(cuid())
  organizationId String
  plateNumber   String
  make          String
  model         String
  year          Int
  color         String?
  category      String?
  /// Controls the online reservation fee (Sedan/SUV/Pickup) — distinct from
  /// the free-text `category` display label above.
  reservationCategory ReservationCategory?
  seats         Int?
  transmission  String?
  description   String?
  photoUrl      String?
  featured      Boolean  @default(false)
  dailyRate     Float
  status        VehicleStatus @default(AVAILABLE)
  odometer      Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  bookingInquiries BookingInquiry[]
  expenses      Expense[]
  maintenanceLogs MaintenanceLog[]
  fuelLogs      FuelLog[]

  @@unique([organizationId, plateNumber])
  @@index([organizationId, status])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String
  address        String?
  driverLicense  String?
  notes          String?
  /// Captured from the customer's driver's license at the counter — powers
  /// automated birthday SMS greetings. Not collected on public self-signup.
  birthday       DateTime?
  /// True once removed from automated SMS nurturing — manually by staff, or
  /// automatically after organization.smsInactivityMonths of no bookings.
  smsOptOut       Boolean  @default(false)
  smsOptOutReason String?
  /// Set only when this customer self-registered on the public storefront.
  passwordHash   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  bookingInquiries BookingInquiry[]
  smsLogs        SmsLog[]
  documents      CustomerDocument[]

  @@unique([organizationId, email])
  @@index([organizationId, name])
}

enum DocumentType {
  DRIVERS_LICENSE
  GOVERNMENT_ID
  PROOF_OF_BILLING
  OTHER
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// ID/license verification — a renter uploads a photo, staff review and
/// approve/reject it. Separate from Customer.driverLicense (the text field
/// staff can type in at the counter) — this is the actual image evidence
/// with an audit trail (who reviewed it, when, why rejected).
model CustomerDocument {
  id               String   @id @default(cuid())
  organizationId   String
  customerId       String
  type             DocumentType
  /// Inline data: URI, same pattern as src/lib/image-upload.ts (logo, hero
  /// image) — no object storage yet, see the tool-stack gap notes on that.
  fileUrl          String
  status           DocumentReviewStatus @default(PENDING)
  rejectionReason  String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([customerId])
}

model Booking {
  id               String   @id @default(cuid())
  organizationId   String
  vehicleId        String
  customerId       String
  startDate        DateTime
  endDate          DateTime
  status           BookingStatus @default(RESERVED)
  source           BookingSource @default(STAFF)
  dailyRate        Float
  totalAmount      Float
  /// Refundable, held separately from the rental payment — never counts
  /// toward revenue. Distinct from reservationFeeDue (the non-refundable
  /// category fee) and amountPaid (rental charges actually collected).
  securityDeposit  Float    @default(0)
  securityDepositStatus SecurityDepositStatus @default(NOT_COLLECTED)
  /// "cash" (collected at pickup/delivery) or "included_in_payment" (paid
  /// upfront as part of a full-payment invoice).
  securityDepositCollectedMethod String?
  securityDepositCollectedAt     DateTime?
  /// "cash", "gcash", or "bank_transfer" — how it was handed back.
  securityDepositRefundMethod    String?
  securityDepositRefundedAt      DateTime?
  securityDepositRefundedByUserId String?
  amountPaid       Float    @default(0)
  paymentStatus    PaymentStatus @default(UNPAID)
  paymongoCheckoutId String?
  /// Stored so "Reserve Now" re-clicked during an already-active unpaid
  /// checkout redirects to the SAME PayMongo session instead of creating a
  /// duplicate (per the v2 handoff's reuse-not-duplicate requirement).
  paymongoCheckoutUrl String?
  /// Set only while status = HOLD. The unit is blocked on the calendar until
  /// this time; if the hold isn't converted before it passes, it's released.
  holdExpiresAt    DateTime?
  /// Set only for bookings made against an accredited corporate account —
  /// no online payment is collected; the company is billed separately.
  corporateClientId String?
  pickupLocation   String?
  dropoffLocation  String?
  rentalOption     RentalOption @default(SELF_DRIVE)
  pickupMethod     BookingLocationMethod @default(GARAGE)
  dropoffMethod    BookingLocationMethod @default(GARAGE)
  startTime        String?
  endTime          String?
  excessHours      Int      @default(0)
  carwashRequested Boolean  @default(false)
  destinationDetails String?
  purposeOfTravel  String?
  howFoundUs       String?
  driverFee        Float    @default(0)
  deliveryFee      Float    @default(0)
  dropoffFee       Float    @default(0)
  carwashFee       Float    @default(0)
  excessTimeFee    Float    @default(0)
  notes            String?

  /// Random token for the public e-sign link mailed to the client; generated
  /// on demand the first time a confirmation email is sent.
  signatureToken   String?  @unique
  signedAt         DateTime?
  signedName       String?
  /// "ONLINE" (clicked the e-sign link) or "PHYSICAL" (staff recorded a
  /// signed printout at pickup).
  signedMethod     String?
  signedIp         String?

  confirmationEmailSentAt DateTime?
  confirmationEmailError  String?

  /// Set once the automated day-before pickup/return SMS reminder is sent,
  /// so the daily cron never double-sends. See src/lib/sms-nurture.ts.
  pickupReminderSentAt  DateTime?
  returnReminderSentAt  DateTime?

  // --- v2 free-hold + reservation-payment audit trail ---
  /// Snapshot of the category reservation fee required to confirm this
  /// hold, taken once at hold creation so a later admin price change never
  /// retroactively changes an in-flight hold. Null for non-hold bookings
  /// (staff-created, corporate, legacy pre-v2 rows).
  reservationFeeDue     Float?
  /// When a PayMongo checkout session was created for this hold (first
  /// "Reserve Now" click) — distinct from paymentConfirmedAt per the
  /// handoff's audit-trail requirement.
  checkoutInitiatedAt   DateTime?
  /// When the webhook verified payment and confirmed the booking.
  paymentConfirmedAt    DateTime?
  /// When PayMongo confirmed the checkout session was successfully
  /// expired (vs. refused because payment was already paid/pending).
  checkoutExpiredAt     DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  corporateClient  CorporateClient? @relation(fields: [corporateClientId], references: [id])
  charges          BookingCharge[]
  refunds          Refund[]
  inspections      BookingInspection[]

  @@index([organizationId])
  @@index([vehicleId])
  @@index([customerId])
  @@index([startDate, endDate])
  @@index([paymongoCheckoutId])
  @@index([corporateClientId])
}

/// A balance-due or incidental charge (late fee, damage, fuel, excess
/// mileage) collected via its own PayMongo checkout so staff never have to
/// take cash — each charge is its own payment event on top of the booking.
model BookingCharge {
  id                 String       @id @default(cuid())
  organizationId     String
  bookingId          String
  description        String
  amount             Float
  status             ChargeStatus @default(PENDING)
  paymongoCheckoutId String?
  /// Persisted so staff can re-send/QR the same link later — PayMongo
  /// checkout sessions aren't re-fetchable by a stable URL otherwise.
  paymongoCheckoutUrl String?
  /// "paymongo" when collected online, "manual" when a staffer recorded an
  /// offline (cash) payment — never created with a checkout session.
  paidVia            String?
  recordedByUserId   String?
  createdAt          DateTime     @default(now())
  paidAt             DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([bookingId])
  @@index([paymongoCheckoutId])
}

enum InspectionType {
  RELEASE
  RETURN
}

/// Vehicle condition recorded at pickup (RELEASE) and return (RETURN) —
/// odometer, fuel level, condition photos, notes. Separate rows since the
/// two happen at different times, possibly by different staff. A damage
/// charge noted here is created as a normal BookingCharge, not duplicated
/// payment logic — staff then collect it the same way as any other charge.
model BookingInspection {
  id                String         @id @default(cuid())
  organizationId    String
  bookingId         String
  type              InspectionType
  odometer          Int?
  fuelLevel         String?
  /// Array of inline data: URIs, same pattern as other image fields — kept
  /// as JSON since SQLite has no native scalar list type in Prisma.
  photos            Json           @default("[]")
  notes             String?
  performedByUserId String
  performedAt       DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, type])
  @@index([organizationId])
}

/// A refund against a paid booking — the admin "exception path" the v2
/// handoff requires alongside the published non-refundable reservation
/// policy (e.g. legally required, or the merchant can't supply the
/// vehicle/service). Every refund needs a staff-written justification
/// (`notes`), separate from PayMongo's own fixed `paymongoReason` enum, so
/// there's a real audit trail for a policy exception.
model Refund {
  id             String   @id @default(cuid())
  organizationId String
  bookingId      String
  amount         Float
  /// PayMongo's fixed category: duplicate | fraudulent | requested_by_customer | others
  paymongoReason String
  notes          String
  status         String   @default("PENDING") // PENDING | SUCCEEDED | FAILED
  paymongoRefundId String?
  error          String?
  /// Loose reference (not a formal relation), matching
  /// BookingCharge.recordedByUserId's existing convention.
  requestedByUserId String
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([bookingId])
}

/// An accredited corporate client whose bookings skip online payment and
/// get billed separately. Gated by a shared access code so a public visitor
/// can't just pick a company name off the dropdown and get a free booking.
model CorporateClient {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  accessCode     String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

/// A "request a callback" lead from the storefront — no payment, no calendar
/// hold. Staff follow up and create a real Booking manually if it converts.
model BookingInquiry {
  id             String        @id @default(cuid())
  organizationId String
  vehicleId      String
  customerId     String
  startDate      DateTime
  endDate        DateTime
  message        String?
  status         InquiryStatus @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([vehicleId])
}

model Expense {
  id             String   @id @default(cuid())
  organizationId String
  vehicleId      String
  category       ExpenseCategory
  amount         Float
  date           DateTime
  description    String?
  vendor         String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vehicleId])
  @@index([date])
  @@index([category])
}

model MaintenanceLog {
  id              String   @id @default(cuid())
  organizationId  String
  vehicleId       String
  type            String
  date            DateTime
  cost            Float    @default(0)
  odometer        Int?
  vendor          String?
  nextDueDate     DateTime?
  nextDueOdometer Int?
  notes           String?
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vehicleId])
  @@index([date])
  @@index([nextDueDate])
}

model FuelLog {
  id             String   @id @default(cuid())
  organizationId String
  vehicleId      String
  date           DateTime
  liters         Float
  cost           Float
  odometer       Int?
  fullTank       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vehicleId])
  @@index([date])
}

model Faq {
  id             String   @id @default(cuid())
  organizationId String
  question       String
  answer         String
  order          Int      @default(0)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Testimonial {
  id             String   @id @default(cuid())
  organizationId String
  authorName     String
  quote          String
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Audit trail + idempotency guard for every automated nurture SMS (and a
/// place to see send history). The unique constraint is what stops the
/// daily cron from double-sending the same birthday/holiday greeting to the
/// same customer if it's ever triggered twice in one day.
model SmsLog {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String?
  /// "PICKUP_REMINDER" | "RETURN_REMINDER" | "BIRTHDAY" | "HOLIDAY"
  kind           String
  /// e.g. "pickup:<bookingId>", "birthday:2026", "holiday:2026-12-25"
  dedupeKey      String
  message        String
  status         String
  error          String?
  sentAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, customerId, dedupeKey])
  @@index([organizationId, kind])
}
